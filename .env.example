# Copy to .env and fill in. Server vars are validated in src/lib/env.ts.
# NEXT_PUBLIC_* and Clerk keys are read by Clerk directly.

# --- App ---
# Public URL of the app (used for the Polar checkout return link).
APP_URL=http://localhost:3000

# --- Database (Postgres, e.g. Neon) ---
DATABASE_URL=

# --- Clerk (auth + organizations) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# --- Cloudflare R2 (generated audio + voice reference audio) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Chatterbox TTS service (Modal) ---
# POST /generate with an x-api-key header; see modal/chatterbox_app.py
CHATTERBOX_API_URL=
CHATTERBOX_API_KEY=

# --- Polar billing ---
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
# "sandbox" or "production"
POLAR_SERVER=sandbox
# Set to "false" ONLY in local dev to skip the subscription paywall.
BILLING_ENABLED=true

# --- Sentry (source map upload at build time) ---
SENTRY_AUTH_TOKEN=
